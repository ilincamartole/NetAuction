<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NetAuction</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebApplication1.styles.css" asp-append-version="true" />

    <style>
        :root {
            --primary-glow: #0d6efd;
            --glass-bg: rgba(255, 255, 255, 0.85);
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #f4f7fa;
            background-image: radial-gradient(at 0% 0%, rgba(13, 110, 253, 0.05) 0px, transparent 50%), radial-gradient(at 100% 100%, rgba(13, 202, 240, 0.05) 0px, transparent 50%);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Navbar Glassmorphism Effect */
        .navbar-glass {
            backdrop-filter: blur(12px) saturate(180%);
            -webkit-backdrop-filter: blur(12px) saturate(180%);
            background-color: var(--glass-bg);
            border-bottom: 1px solid rgba(255, 255, 255, 0.3);
            position: sticky;
            top: 0;
            z-index: 1030;
            transition: all 0.3s ease;
        }

        .navbar-brand {
            font-weight: 800;
            letter-spacing: -1px;
            background: linear-gradient(45deg, #0d6efd, #0dcaf0);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            transition: transform 0.3s ease;
        }

            .navbar-brand:hover {
                transform: scale(1.05);
            }

        .nav-link {
            font-weight: 600;
            font-size: 0.95rem;
            color: #495057 !important;
            padding: 0.5rem 1.2rem !important;
            border-radius: 50px;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

            .nav-link:hover {
                background: rgba(13, 110, 253, 0.08);
                color: #0d6efd !important;
                transform: translateY(-1px);
            }

            .nav-link.active-link {
                background: #0d6efd;
                color: white !important;
                box-shadow: 0 4px 15px rgba(13, 110, 253, 0.3);
            }

            /* Stil special pentru butonul de Ghid Inteligent AI */
            .nav-link.ai-assistant-btn {
                background: rgba(13, 110, 253, 0.06);
                border: 1px dashed rgba(13, 110, 253, 0.3);
                color: #0d6efd !important;
            }

                .nav-link.ai-assistant-btn:hover {
                    background: #0d6efd;
                    color: white !important;
                    border-color: #0d6efd;
                    box-shadow: 0 4px 15px rgba(13, 110, 253, 0.2);
                }

                .nav-link.ai-assistant-btn.active-link {
                    background: #0d6efd;
                    color: white !important;
                    border-color: #0d6efd;
                }

        .main-wrapper {
            flex: 1;
            padding-top: 20px;
        }

        footer {
            background: white;
            border-top: 1px solid rgba(0,0,0,0.05);
            margin-top: auto;
        }

        .footer-link {
            transition: all 0.2s;
            color: #6c757d;
        }

            .footer-link:hover {
                color: #0d6efd;
                transform: scale(1.15);
            }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }

        ::-webkit-scrollbar-track {
            background: #f1f1f1;
        }

        ::-webkit-scrollbar-thumb {
            background: #0d6efd;
            border-radius: 10px;
        }

            ::-webkit-scrollbar-thumb:hover {
                background: #0b5ed7;
            }
    </style>
</head>
<body>
    <header class="sticky-top">
        <nav class="navbar navbar-expand-sm navbar-glass py-3">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center animate__animated animate__fadeInLeft" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-gavel me-2 fs-3"></i> NetAuction
                </a>

                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <i class="bi bi-list fs-2 text-dark"></i>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 ms-lg-5 gap-2">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active-link" : "")"
                               asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Licitatii" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active-link" : "")"
                               asp-area="" asp-controller="Licitatii" asp-action="Index">
                                <i class="bi bi-shop me-1"></i> Licitații
                            </a>
                        </li>
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "DashboardCumparator" ? "active-link" : "")"
                                   asp-area="" asp-controller="Licitatii" asp-action="DashboardCumparator">
                                    <i class="bi bi-hammer me-1"></i> Ofertele Mele
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link ai-assistant-btn @(ViewContext.RouteData.Values["Action"]?.ToString() == "Asistent" ? "active-link" : "")"
                                   asp-area="" asp-controller="Licitatii" asp-action="Asistent">
                                    <i class="bi bi-robot me-1 animate__animated animate__pulse animate__infinite d-inline-block"></i> Asistent AI
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Profil" ? "active-link" : "") text-primary fw-bold"
                                   asp-area="" asp-controller="Profil" asp-action="Index">
                                    <i class="bi bi-person-circle me-1"></i> Profil
                                </a>
                            </li>
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-3 animate__animated animate__fadeInRight">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <a href="/Licitatii/Favorite" class="btn btn-light rounded-pill position-relative border px-3">
                                <i class="bi bi-heart-fill text-danger me-1"></i> Favorite
                                <span id="watchlist-navbar-count" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger shadow-sm" style="display: none; font-size: 0.75rem;">
                                    0
                                </span>
                            </a>
                        }
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="main-wrapper">
        <div class="container">
            <main role="main" class="pb-5">
                @RenderBody()
            </main>
        </div>
    </div>

    <footer class="py-5">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start">
                    <span class="text-dark fw-bold fs-5">NetAuction</span>
                    <p class="text-muted small mb-0 mt-1">
                        &copy; 2026 - Toate drepturile rezervate. Creat cu <i class="bi bi-heart-fill text-danger"></i> pentru comunitate.
                    </p>
                </div>
                <div class="col-md-6 text-center text-md-end mt-4 mt-md-0">
                    <div class="d-flex justify-content-center justify-content-md-end gap-4 mb-3">
                        <a href="#" class="footer-link fs-4"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="footer-link fs-4"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="footer-link fs-4"><i class="bi bi-twitter-x"></i></a>
                        <a href="#" class="footer-link fs-4"><i class="bi bi-discord"></i></a>
                    </div>
                    <a class="text-muted text-decoration-none small fw-bold" asp-area="" asp-controller="Home" asp-action="Privacy">
                        Privacy Policy
                    </a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>
    <script>
        // --- SYNC GLOBAL FAVORITE NAVBAR INDICATOR ---
        function updateGlobalWatchlistCount() {
            const badge = document.getElementById('watchlist-navbar-count');
            if (!badge) return;
            try {
                const saved = localStorage.getItem('netauction_watchlist');
                const list = saved ? JSON.parse(saved) : [];
                if (list && list.length > 0) {
                    badge.innerText = list.length;
                    badge.style.display = 'inline-block';
                } else {
                    badge.style.display = 'none';
                }
            } catch (e) {
                console.error("Eroare la citirea listei salvate local", e);
            }
        }

        // Ascultăm evenimentele de storage pentru a actualiza instant numărul între tab-uri sau la interacțiuni
        window.addEventListener('storage', updateGlobalWatchlistCount);
        // Rulăm verificarea la fiecare încărcare completă de pagină
        document.addEventListener('DOMContentLoaded', updateGlobalWatchlistCount);
        // Observator la nivel de interval scurt pentru acțiuni interne asincrone
        setInterval(updateGlobalWatchlistCount, 800);

        // --- PIPELINE NOTIFICĂRI LIVE SIGNALR ---
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/auctionHub")
            .withAutomaticReconnect()
            .build();

        connection.on("ReceiveOutbidNotification", function (title, url) {
            const toastId = 'outbid_' + Date.now();
            const toastHTML = `
                <div id="${toastId}" class="position-fixed bottom-0 end-0 p-4 animate__animated animate__fadeInRight" style="z-index: 11000;">
                    <div class="card border-0 shadow-lg bg-dark text-white rounded-5" style="width: 320px;">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-center mb-3">
                                <div class="bg-danger rounded-circle p-2 me-3 d-flex align-items-center justify-content-center" style="width:35px; height:35px;">
                                    <i class="bi bi-lightning-fill text-white"></i>
                                </div>
                                <h6 class="mb-0 fw-bold">Alertă Ofertă!</h6>
                            </div>
                            <p class="small opacity-75">Ai fost depășit la <strong>${title}</strong>. Acționează rapid!</p>
                            <div class="d-flex gap-2 mt-3">
                                <a href="${url}" class="btn btn-primary btn-sm rounded-pill flex-grow-1 fw-bold">Revino acum</a>
                                <button class="btn btn-outline-light btn-sm rounded-circle" onclick="document.getElementById('${toastId}').remove()">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>`;

            document.body.insertAdjacentHTML('beforeend', toastHTML);

            try {
                new Audio('https://assets.mixkit.co/active_storage/sfx/2869/2869-preview.mp3').play();
            } catch(e) { console.log("Redarea audio automată a fost blocată de browser"); }
        });

        connection.start().catch(err => console.error("SignalR Error: " + err.toString()));

        $(window).scroll(function() {
            if ($(this).scrollTop() > 50) {
                $('.navbar-glass').css('padding', '10px 0');
                $('.navbar-glass').addClass('shadow-sm');
            } else {
                $('.navbar-glass').css('padding', '20px 0');
                $('.navbar-glass').removeClass('shadow-sm');
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>