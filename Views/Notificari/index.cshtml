@model IEnumerable<WebApplication1.Models.Notificare>

@{
    ViewData["Title"] = "Centru Notificări";
}

<div class="container py-5" style="background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%); min-height: 90vh;">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="fw-bolder text-dark mb-1"><i class="bi bi-bell-fill text-primary"></i> Notificările Mele</h2>
                    <p class="text-muted small">Aici găsești noutățile despre plățile și licitațiile tale.</p>
                </div>
                <span class="badge bg-primary rounded-pill px-3 py-2">Total: @Model.Count()</span>
            </div>

            @if (!Model.Any())
            {
                <div class="card border-0 shadow-sm rounded-5 p-5 text-center bg-white">
                    <div class="card-body">
                        <i class="bi bi-bell-slash display-3 text-muted mb-3"></i>
                        <h4 class="fw-bold">Nicio notificare momentan</h4>
                        <p class="text-muted">Te vom anunța aici imediat ce apar noutăți despre licitații.</p>
                    </div>
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var notificare in Model)
                    {
                        <div class="card border-0 shadow-sm rounded-4 p-3 transition-all @(notificare.EsteCitita ? "bg-white opacity-75" : "bg-white border-start border-primary border-4 shadow-md")">
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="rounded-circle p-2 @(notificare.EsteCitita ? "bg-light text-muted" : "bg-primary-subtle text-primary")">
                                        <i class="bi @(notificare.EsteCitita ? "bi-envelope-open" : "bi-envelope-fill") fs-4"></i>
                                    </div>
                                    <div>
                                        <p class="mb-1 fw-medium text-dark">@notificare.Mesaj</p>
                                        <small class="text-muted" style="font-size: 0.8rem;">
                                            <i class="bi bi-clock"></i> @notificare.DataCreare.ToString("dd MMM, HH:mm")
                                        </small>
                                    </div>
                                </div>

                                @if (!notificare.EsteCitita)
                                {
                                    <form asp-action="MarcheazaCitita" asp-route-id="@notificare.Id" method="post" class="m-0">
                                        <button type="submit" class="btn btn-sm btn-light rounded-pill px-3 border hover-primary">
                                            Vezi detalii <i class="bi bi-chevron-right ms-1"></i>
                                        </button>
                                    </form>
                                }
                                else if (!string.IsNullOrEmpty(notificare.Link))
                                {
                                    <a href="@notificare.Link" class="btn btn-sm btn-link text-decoration-none text-muted">
                                        Revezi pagina <i class="bi bi-arrow-right"></i>
                                    </a>
                                }
                            </div>
                        </div>
                    }
                </div>
            }

        </div>
    </div>
</div>

<style>
    .rounded-4 {
        border-radius: 1.25rem !important;
    }

    .rounded-5 {
        border-radius: 2rem !important;
    }

    .shadow-md {
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.08) !important;
    }

    .transition-all {
        transition: all 0.2s ease-in-out;
    }

    .hover-primary:hover {
        background-color: #0d6efd !important;
        color: white !important;
    }
</style>