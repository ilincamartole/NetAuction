@model WebApplication1.Models.Licitatie
@using WebApplication1.Models

@{
    ViewData["Title"] = "Lansează Licitație";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Header Pagina -->
            <div class="text-center mb-5">
                <div class="bg-primary-subtle d-inline-block p-3 rounded-circle mb-3">
                    <i class="bi bi-megaphone-fill text-primary fs-2"></i>
                </div>
                <h2 class="fw-bold">Lansează o licitație nouă</h2>
                <p class="text-muted">Completează detaliile de mai jos pentru a-ți pune obiectul în lumina reflectoarelor.</p>
            </div>

            <!-- Card Formular -->
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-body p-4 p-md-5">
                    <form asp-action="Create" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 small mb-4" role="alert"></div>

                        <div class="row g-4">
                            <!-- Titlu -->
                            <div class="col-12">
                                <label asp-for="titlu" class="form-label fw-semibold">
                                    <i class="bi bi-type me-1 text-primary"></i> Titlu Licitație
                                </label>
                                <input asp-for="titlu" class="form-control form-control-lg border-2 shadow-none" placeholder="Ex: Ceas Vintage Omega 1960" />
                                <span asp-validation-for="titlu" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <!-- Categorie -->
                            <div class="col-md-6">
                                <label asp-for="Categorie" class="form-label fw-semibold">
                                    <i class="bi bi-tag me-1 text-primary"></i> Categorie
                                </label>
                                <select asp-for="Categorie" class="form-select border-2 shadow-none"
                                        asp-items="Html.GetEnumSelectList<WebApplication1.Models.CategorieLicitatie>()">
                                    <option value="">-- Alege o categorie --</option>
                                </select>
                                <span asp-validation-for="Categorie" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <!-- Pret -->
                            <div class="col-md-6">
                                <label asp-for="PretPornire" class="form-label fw-semibold">
                                    <i class="bi bi-currency-exchange me-1 text-primary"></i> Preț Pornire (RON)
                                </label>
                                <div class="input-group">
                                    <input asp-for="PretPornire" class="form-control border-2 shadow-none" type="number" step="0.01" min="0.01" placeholder="0.00" />
                                    <span class="input-group-text border-2 bg-light fw-bold">RON</span>
                                </div>
                                <span asp-validation-for="PretPornire" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <!-- Descriere -->
                            <div class="col-12">
                                <label asp-for="descriere" class="form-label fw-semibold">
                                    <i class="bi bi-justify-left me-1 text-primary"></i> Descriere Detaliată
                                </label>
                                <textarea asp-for="descriere" class="form-control border-2 shadow-none" rows="4" placeholder="Povestește-ne despre obiect, starea sa și orice detalii relevante..."></textarea>
                                <span asp-validation-for="descriere" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <!-- Data Finalizare -->
                            <div class="col-md-6">
                                <label asp-for="data_finalizare" class="form-label fw-semibold">
                                    <i class="bi bi-calendar-event me-1 text-primary"></i> Data Finalizare
                                </label>
                                <input asp-for="data_finalizare" class="form-control border-2 shadow-none" type="datetime-local" id="dataFinalizare" />
                                <span asp-validation-for="data_finalizare" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <!-- Incarcare Imagine -->
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">
                                    <i class="bi bi-image me-1 text-primary"></i> Încarcă Poză Produs
                                </label>
                                <input type="file" name="fisierImagine" id="uploadImagine" class="form-control border-2 shadow-none" accept="image/*" />
                                <div class="form-text small">Max 10MB. Recomandat: 800x600px.</div>
                            </div>

                            <!-- Butoane Actiune -->
                            <div class="col-12 mt-5">
                                <div class="d-grid gap-2 d-md-flex justify-content-md-between">
                                    <a asp-action="Index" class="btn btn-light rounded-pill px-4 fw-bold">
                                        <i class="bi bi-arrow-left"></i> Înapoi
                                    </a>
                                    <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold shadow">
                                        Lansează Licitația <i class="bi bi-rocket-takeoff ms-2"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Focus styling pentru input-uri mai clare */
    .form-control:focus, .form-select:focus {
        border-color: #0d6efd;
        background-color: #f8f9ff;
    }

    .bg-primary-subtle {
        background-color: #e7f1ff;
    }

    /* Stil pentru textarea care se autoresizează (opțional) */
    textarea {
        resize: none;
    }
</style>

<script>
    // Blochează selectarea datelor din trecut în browser
    const now = new Date();
    now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
    document.getElementById('dataFinalizare').min = now.toISOString().slice(0,16);
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}