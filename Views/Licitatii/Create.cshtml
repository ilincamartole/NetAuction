@model WebApplication1.Models.Licitatie
@using WebApplication1.Models

@{
    ViewData["Title"] = "Lansează Licitație";
}

<div class="container-fluid py-5" style="background: linear-gradient(135deg, #f0f4f8 0%, #d9e2ec 100%); min-height: 100vh;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-xl-10">

                <!-- Page Title -->
                <div class="d-flex align-items-center mb-5 animate__animated animate__fadeIn">
                    <div class="bg-primary rounded-4 p-3 shadow-lg me-4">
                        <i class="bi bi-megaphone-fill text-white fs-2"></i>
                    </div>
                    <div>
                        <h1 class="fw-bolder text-dark mb-0 tracking-tight">Creează o nouă oportunitate</h1>
                        <p class="text-secondary mb-0 fs-5 fw-light">Transformă-ți obiectele în povești de succes pe NetAuction.</p>
                    </div>
                </div>

                <div class="row g-4">
                    <!-- Form Side -->
                    <div class="col-lg-8">
                        <div class="card border-0 shadow-2-strong rounded-5 overflow-hidden animate__animated animate__fadeInLeft">
                            <div class="card-body p-4 p-md-5 bg-white">
                                <form asp-action="Create" method="post" enctype="multipart/form-data" id="auctionForm">
                                    <div asp-validation-summary="ModelOnly" class="alert alert-danger-subtle border-0 rounded-4 small mb-4" role="alert"></div>

                                    <div class="row g-4">
                                        <!-- Section: Informații Generale -->
                                        <div class="col-12">
                                            <h5 class="fw-bold text-primary mb-4 border-bottom pb-2 d-flex align-items-center">
                                                <i class="bi bi-info-circle-fill me-2"></i> Informații de bază
                                            </h5>
                                        </div>

                                        <div class="col-12">
                                            <div class="form-floating mb-3">
                                                <input asp-for="titlu" class="form-control border-0 bg-light rounded-4 px-4" placeholder="Ex: Ceas Vintage Omega 1960" id="floatingTitlu" />
                                                <label asp-for="titlu" class="ps-4">Titlu Licitație</label>
                                                <span asp-validation-for="titlu" class="text-danger small px-2"></span>
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <div class="form-floating mb-3">
                                                <select asp-for="Categorie" class="form-select border-0 bg-light rounded-4 px-4" id="floatingCat"
                                                        asp-items="Html.GetEnumSelectList<WebApplication1.Models.CategorieLicitatie>()">
                                                    <option value="">-- Alege --</option>
                                                </select>
                                                <label asp-for="Categorie" class="ps-4">Categorie</label>
                                                <span asp-validation-for="Categorie" class="text-danger small px-2"></span>
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <div class="form-floating mb-3">
                                                <input asp-for="PretPornire" class="form-control border-0 bg-light rounded-4 px-4" type="number" step="0.01" id="floatingPret" placeholder="0.00" />
                                                <button type="button" class="btn btn-outline-primary rounded-pill mt-2 w-100" id="btnAiPret" onclick="sugereazaPretAI()">
                                                    <i class="bi bi-stars me-2"></i> Sugerează preț cu AI
                                                </button>
                                                <div id="aiPretStatus" class="small text-muted mt-1"></div>                                                <label asp-for="PretPornire" class="ps-4">Preț Pornire (RON)</label>
                                                <span asp-validation-for="PretPornire" class="text-danger small px-2"></span>
                                            </div>
                                        </div>

                                        <!-- Section: Detalii și Imagine -->
                                        <div class="col-12 mt-4">
                                            <h5 class="fw-bold text-primary mb-4 border-bottom pb-2 d-flex align-items-center">
                                                <i class="bi bi-camera-fill me-2"></i> Prezentare Vizuală
                                            </h5>
                                        </div>

                                        <div class="col-12">
                                            <div class="form-floating mb-3">
                                                <textarea asp-for="descriere" class="form-control border-0 bg-light rounded-4 px-4" style="height: 150px" placeholder="Detalii..." id="floatingDesc"></textarea>
                                                <label asp-for="descriere" class="ps-4">Descriere Detaliată</label>
                                                <span asp-validation-for="descriere" class="text-danger small px-2"></span>
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <label class="form-label fw-bold text-dark mb-2 ms-2 small">Data Finalizare</label>
                                            <input asp-for="data_finalizare" class="form-control border-0 bg-light rounded-4 py-3 px-4 shadow-none" type="datetime-local" id="dataFinalizare" />
                                            <span asp-validation-for="data_finalizare" class="text-danger small px-2"></span>
                                        </div>

                                        <div class="col-md-6">
                                            <label class="form-label fw-bold text-dark mb-2 ms-2 small">Poză Produs</label>
                                            <div class="input-group">
                                                <input type="file" name="fisierImagine" id="uploadImagine" class="form-control border-0 bg-light rounded-4 py-3" accept="image/*" />
                                            </div>
                                            <div class="form-text text-muted ps-2" style="font-size: 0.7rem;">Format acceptat: JPG, PNG, WEBP. Max 10MB.</div>
                                        </div>

                                        <!-- Butoane -->
                                        <div class="col-12 mt-5">
                                            <div class="row g-3">
                                                <div class="col-md-4">
                                                    <a asp-action="Index" class="btn btn-light w-100 rounded-pill py-3 fw-bold text-secondary">
                                                        <i class="bi bi-arrow-left me-2"></i>Anulează
                                                    </a>
                                                </div>
                                                <div class="col-md-8">
                                                    <button type="submit" class="btn btn-primary w-100 rounded-pill py-3 fw-bold shadow-lg hover-up-btn">
                                                        Publică Licitația <i class="bi bi-rocket-takeoff ms-2"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>

                    <!-- Preview Sidebar -->
                    <div class="col-lg-4 d-none d-lg-block animate__animated animate__fadeInRight">
                        <div class="sticky-top" style="top: 2rem;">
                            <div class="card border-0 shadow-lg rounded-5 overflow-hidden">
                                <div class="card-header bg-dark text-white text-center py-3">
                                    <span class="small fw-bold tracking-wider">LIVE PREVIEW</span>
                                </div>
                                <div class="card-body p-0">
                                    <div class="preview-img-container bg-light d-flex align-items-center justify-content-center" style="height: 250px;">
                                        <img id="imagePreview" src="https://placehold.co/600x400/f8f9fa/dee2e6?text=Încărcați+o+imagine" class="img-fluid object-fit-cover w-100 h-100" />
                                    </div>
                                    <div class="p-4">
                                        <h5 id="previewTitle" class="fw-bold text-dark text-truncate">Titlu Produs</h5>
                                        <p id="previewCat" class="badge bg-primary-subtle text-primary rounded-pill mb-3">Categorie</p>
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <small class="text-muted d-block">Preț Start</small>
                                                <span class="fw-bolder text-success fs-4"><span id="previewPrice">0</span> RON</span>
                                            </div>
                                            <div class="text-end">
                                                <small class="text-muted d-block">Durată</small>
                                                <span class="badge bg-light text-dark border"><i class="bi bi-clock me-1"></i> SETAT</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Tips Card -->
                            <div class="card border-0 bg-primary bg-gradient text-white rounded-5 mt-4 shadow-sm p-4">
                                <h6 class="fw-bold mb-3"><i class="bi bi-lightbulb me-2"></i>Sfat Profesional</h6>
                                <p class="small mb-0 opacity-75 leading-relaxed">
                                    Produsele cu descrieri lungi și poze clare primesc cu 65% mai multe oferte. Asigură-te că menționezi orice defect minor pentru a construi încredere.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Premium UI Styles */
    .tracking-tight {
        letter-spacing: -1px;
    }

    .tracking-wider {
        letter-spacing: 2px;
    }

    .shadow-2-strong {
        box-shadow: 0 10px 40px rgba(0,0,0,0.08);
    }

    .leading-relaxed {
        line-height: 1.6;
    }

    .form-control:focus, .form-select:focus {
        background-color: #ffffff !important;
        box-shadow: 0 0 0 4px rgba(13, 110, 253, 0.15);
    }

    .form-floating > label {
        color: #6c757d;
        font-weight: 500;
    }

    .hover-up-btn {
        transition: all 0.3s ease;
    }

        .hover-up-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 30px rgba(13, 110, 253, 0.3) !important;
        }

    .bg-primary-subtle {
        background-color: #e7f1ff !important;
    }

    .alert-danger-subtle {
        background-color: #fff5f5;
        color: #c53030;
    }

    /* Custom Textarea scrollbar */
    textarea::-webkit-scrollbar {
        width: 6px;
    }

    textarea::-webkit-scrollbar-thumb {
        background: #dee2e6;
        border-radius: 10px;
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // Real-time Preview Sync
        const titluInput = document.getElementById('floatingTitlu');
        const pretInput = document.getElementById('floatingPret');
        const catInput = document.getElementById('floatingCat');
        const imgInput = document.getElementById('uploadImagine');

        titluInput.addEventListener('input', (e) => {
            document.getElementById('previewTitle').innerText = e.target.value || "Titlu Produs";
        });

        pretInput.addEventListener('input', (e) => {
            document.getElementById('previewPrice').innerText = e.target.value || "0";
        });

        catInput.addEventListener('change', (e) => {
            const selectedText = e.target.options[e.target.selectedIndex].text;
            document.getElementById('previewCat').innerText = selectedText === "-- Alege --" ? "Categorie" : selectedText;
        });

        imgInput.onchange = evt => {
            const [file] = imgInput.files;
            if (file) {
                document.getElementById('imagePreview').src = URL.createObjectURL(file);
            }
        }

        // Date Restriction Logic (Păstrat neschimbat)
        const now = new Date();
        now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
        document.getElementById('dataFinalizare').min = now.toISOString().slice(0, 16);
    </script>
    <script>
        async function sugereazaPretAI() {
            const titlu = document.getElementById('floatingTitlu').value;
            const statusDiv = document.getElementById('aiPretStatus');
            const btn = document.getElementById('btnAiPret');

            if (!titlu || titlu.length < 3) {
                statusDiv.textContent = '⚠️ Introdu mai întâi titlul licitației.';
                statusDiv.className = 'small text-warning mt-1';
                return;
            }

            btn.disabled = true;
            statusDiv.textContent = '⏳ AI-ul calculează prețul...';
            statusDiv.className = 'small text-muted mt-1';

            try {
                const response = await fetch('/api/ai/sugereaza-pret', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ titlu: titlu })
                });

                const data = await response.json();

                if (response.ok && data.pret) {
                    document.getElementById('floatingPret').value = data.pret;
                    // Actualizează și preview-ul din pagină dacă există
                    const previewPrice = document.getElementById('previewPrice');
                    if (previewPrice) previewPrice.innerText = data.pret;

                    statusDiv.textContent = `✅ AI sugerează ${data.pret} RON ca preț de pornire.`;
                    statusDiv.className = 'small text-success mt-1';
                } else {
                    statusDiv.textContent = '❌ Nu s-a putut genera un preț. Încearcă din nou.';
                    statusDiv.className = 'small text-danger mt-1';
                }
            } catch (e) {
                statusDiv.textContent = '❌ Eroare de conexiune.';
                statusDiv.className = 'small text-danger mt-1';
            } finally {
                btn.disabled = false;
            }
        }
    </script>
}