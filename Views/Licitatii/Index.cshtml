@model IEnumerable<WebApplication1.Models.Licitatie>
@using System.Security.Claims

@{
    ViewData["Title"] = "Marketplace de Elită";
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

<!-- Overlay Special pentru Câștigător (WOW Effect) -->
@if (ViewBag.ShowWinnerModal == true)
{
    <div id="winnerOverlay" class="winner-overlay">
        <div class="winner-content animate__animated animate__zoomInDown">
            <div class="confetti-cannon"></div>
            <div class="winner-card shadow-2-strong rounded-5 overflow-hidden">
                <div class="card-header-win">
                    <div class="trophy-wrapper">
                        <i class="bi bi-trophy-fill trophy-icon animate__animated animate__infinite animate__tada"></i>
                    </div>
                    <h2 class="win-title">ESTI CASTIGATOR!</h2>
                </div>
                <div class="card-body p-5 text-center">
                    <p class="fs-5 text-muted mb-1">Felicitări! Ai plasat cea mai bună ofertă pentru:</p>
                    <h3 class="product-name-win">@ViewBag.ProductName</h3>
                    <div class="divider-win"></div>
                    <p class="small text-muted mb-4 px-4">Verifică secțiunea "Ofertele Mele" pentru a finaliza tranzacția cu vânzătorul.</p>

                    <button type="button" class="btn btn-win-action rounded-pill" onclick="closeWinnerOverlay()">
                        <span>MULȚUMESC!</span>
                        <i class="bi bi-stars ms-2"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Canvas Confetti Engine -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <script>
        function closeWinnerOverlay() {
            const overlay = document.getElementById('winnerOverlay');
            overlay.classList.add('animate__animated', 'animate__fadeOut');
            setTimeout(() => overlay.remove(), 500);
        }

        function fireWorks() {
            var duration = 7 * 1000;
            var animationEnd = Date.now() + duration;
            var defaults = { startVelocity: 45, spread: 360, ticks: 100, zIndex: 10000 };

            function randomInRange(min, max) {
              return Math.random() * (max - min) + min;
            }

            var interval = setInterval(function() {
              var timeLeft = animationEnd - Date.now();

              if (timeLeft <= 0) {
                return clearInterval(interval);
              }

              var particleCount = 70 * (timeLeft / duration);

              // Explozii multiple din puncte diferite
              confetti(Object.assign({}, defaults, { particleCount, origin: { x: randomInRange(0.1, 0.3), y: Math.random() - 0.2 } }));
              confetti(Object.assign({}, defaults, { particleCount, origin: { x: randomInRange(0.7, 0.9), y: Math.random() - 0.2 } }));
            }, 250);
        }

        // Lansare automată la încărcare
        window.addEventListener('load', fireWorks);
    </script>
}

<div class="container-fluid py-5 px-lg-5" style="background: #f8f9fa;">
    <!-- Header Hero Section -->
    <div class="row align-items-center mb-5 animate__animated animate__fadeIn">
        <div class="col-lg-7">
            <h1 class="display-4 fw-bolder text-dark tracking-tight mb-2">
                Descoperă <span class="text-primary text-gradient">Comori</span> Digitale
            </h1>
            <p class="fs-5 text-muted fw-light">Licitează în timp real pentru cele mai rare obiecte din comunitatea NetAuction.</p>
        </div>
        <div class="col-lg-5 text-lg-end">
            @if (User.Identity.IsAuthenticated)
            {
                <a asp-action="Create" class="btn btn-primary btn-lg rounded-pill px-5 py-3 shadow-lg hover-lift">
                    <i class="bi bi-plus-lg me-2"></i>Lansează o Licitație
                </a>
            }
        </div>
    </div>

    <!-- Smart Filter Bar -->
    <div class="card border-0 shadow-sm rounded-5 mb-5 glass-filter animate__animated animate__fadeInUp">
        <div class="card-body p-4">
            <form asp-action="Index" method="get" class="row g-3 align-items-end">
                <div class="col-12 mb-2">
                    <div class="d-flex gap-2 p-1 bg-light rounded-pill d-inline-flex border">
                        <a class="btn rounded-pill px-4 py-2 @(Context.Request.Query["filter"] != "mine" ? "btn-white shadow-sm" : "btn-light text-muted")"
                           asp-action="Index" asp-route-filter="all">Toate</a>

                        @if (User.Identity.IsAuthenticated)
                        {
                            <a class="btn rounded-pill px-4 py-2 @(Context.Request.Query["filter"] == "mine" ? "btn-white shadow-sm" : "btn-light text-muted")"
                               asp-action="Index" asp-route-filter="mine">Ale Mele</a>
                        }
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-floating">
                        <input type="text" name="searchString" class="form-control border-0 bg-light rounded-4 px-4 shadow-none"
                               id="searchLabel" placeholder="Căutare..." value="@Context.Request.Query["searchString"]">
                        <label for="searchLabel" class="ps-4">Ce cauți astăzi?</label>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="form-floating">
                        <select name="categorie" class="form-select border-0 bg-light rounded-4 px-4 shadow-none" id="catLabel"
                                asp-items="Html.GetEnumSelectList<WebApplication1.Models.CategorieLicitatie>()">
                            <option value="">Toate categoriile</option>
                        </select>
                        <label for="catLabel" class="ps-4">Categorie</label>
                    </div>
                </div>

                <div class="col-md-2">
                    <div class="form-floating">
                        <input type="number" name="pretMax" class="form-control border-0 bg-light rounded-4 px-4 shadow-none"
                               id="priceLabel" placeholder="Buget" value="@Context.Request.Query["pretMax"]">
                        <label for="priceLabel" class="ps-4">Buget Max (RON)</label>
                    </div>
                </div>

                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-dark flex-grow-1 rounded-4 py-3 fw-bold transition-all">
                        <i class="bi bi-search me-2"></i>Caută
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-4 py-3 px-3">
                        <i class="bi bi-arrow-counterclockwise fs-5"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Results Grid -->
    <div class="row g-4 animate__animated animate__fadeInUp animate__delay-1s">
        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5">
                <div class="bg-white d-inline-block p-5 rounded-5 shadow-sm">
                    <i class="bi bi-emoji-frown text-muted display-1"></i>
                    <h3 class="mt-4 fw-bold">Niciun rezultat găsit</h3>
                    <p class="text-muted">Încearcă să schimbi filtrele.</p>
                </div>
            </div>
        }

        @foreach (var item in Model)
        {
            <div class="col-sm-6 col-xl-3">
                <div class="card h-100 border-0 shadow-sm bento-card rounded-5 overflow-hidden transition-all bg-white">
                    <div class="position-relative overflow-hidden" style="height: 240px;">
                        @if (!string.IsNullOrEmpty(item.ImaginePath))
                        {
                            <img src="~/images/@item.ImaginePath" class="w-100 h-100 object-fit-cover transition-transform" alt="@item.titlu">
                        }
                        else
                        {
                            <div class="w-100 h-100 bg-light-subtle d-flex align-items-center justify-content-center">
                                <i class="bi bi-image text-muted display-4"></i>
                            </div>
                        }

                        <div class="position-absolute top-0 start-0 m-3">
                            <span class="badge glass-badge rounded-pill px-3 py-2 text-white fw-bold">
                                @item.Categorie
                            </span>
                        </div>

                        @if (item.data_finalizare < DateTime.UtcNow.AddHours(2) && !item.EsteIncheiata)
                        {
                            <div class="position-absolute bottom-0 start-0 w-100 p-2 bg-danger text-white text-center small fw-bold animate__animated animate__pulse animate__infinite">
                                <i class="bi bi-clock-history me-1"></i> EXPIRĂ CURÂND
                            </div>
                        }
                    </div>

                    <div class="card-body p-4">
                        <h5 class="fw-bold text-dark mb-3 text-truncate-2" style="height: 3rem;">@item.titlu</h5>
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div>
                                <p class="text-muted small text-uppercase fw-bold mb-0" style="font-size: 0.65rem;">Preț Actual</p>
                                <span class="fs-4 fw-bolder text-success">@item.PretCurent <small class="fs-6">RON</small></span>
                            </div>
                            <div class="text-end">
                                <p class="text-muted small text-uppercase fw-bold mb-0" style="font-size: 0.65rem;">Dată Limită</p>
                                <span class="fw-bold text-dark">@item.data_finalizare.ToString("dd MMM")</span>
                            </div>
                        </div>
                        <div class="d-flex gap-2">
                            <a asp-action="Details" asp-route-id="@item.id" class="btn btn-primary flex-grow-1 rounded-pill py-2 fw-bold shadow-sm">
                                Licitează <i class="bi bi-arrow-right-short ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    /* WOW NOTIFICATION STYLING */
    .winner-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(15, 23, 42, 0.85); /* Deep dark glass */
        backdrop-filter: blur(12px);
        z-index: 10000;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

    .winner-content {
        max-width: 500px;
        width: 100%;
        position: relative;
    }

    .winner-card {
        background: white;
        border: none;
        animation: cardFloat 3s ease-in-out infinite;
    }

    .card-header-win {
        background: linear-gradient(135deg, #0d6efd 0%, #00d2ff 100%);
        padding: 50px 20px;
        text-align: center;
        color: white;
        position: relative;
    }

    .trophy-wrapper {
        width: 100px;
        height: 100px;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
        border: 4px solid rgba(255, 255, 255, 0.4);
    }

    .trophy-icon {
        font-size: 3rem;
        color: #FFD700; /* Gold */
        filter: drop-shadow(0 0 10px rgba(255,215,0,0.5));
    }

    .win-title {
        font-weight: 900;
        letter-spacing: 2px;
        margin: 0;
        text-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }

    .product-name-win {
        font-weight: 800;
        color: #0d6efd;
        margin-top: 10px;
    }

    .divider-win {
        width: 60px;
        height: 4px;
        background: #0d6efd;
        border-radius: 2px;
        margin: 20px auto;
        opacity: 0.3;
    }

    .btn-win-action {
        background: #0d6efd;
        color: white;
        padding: 15px 40px;
        font-weight: 700;
        font-size: 1.1rem;
        border: none;
        box-shadow: 0 10px 20px rgba(13, 110, 253, 0.3);
        transition: all 0.3s ease;
    }

        .btn-win-action:hover {
            background: #0052cc;
            transform: scale(1.05);
            color: white;
        }

    @@keyframes cardFloat {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-15px);
        }
    }

    /* EXISTING STYLES */
    .text-gradient {
        background: linear-gradient(45deg, #0d6efd, #0dcaf0);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .rounded-5 {
        border-radius: 1.5rem !important;
    }

    .glass-filter {
        background: rgba(255, 255, 255, 0.8);
        backdrop-filter: blur(10px);
    }

    .btn-white {
        background: white;
        color: #0d6efd;
    }

    .bento-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 1.5rem 3rem rgba(0,0,0,0.1) !important;
    }

        .bento-card:hover img {
            transform: scale(1.08);
        }

    .glass-badge {
        background: rgba(0,0,0,0.5);
        backdrop-filter: blur(5px);
    }

    .hover-lift:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 20px rgba(13, 110, 253, 0.3) !important;
    }

    .text-truncate-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>