@model IEnumerable<WebApplication1.Models.Licitatie>
@using System.Security.Claims

@{
    ViewData["Title"] = "Marketplace de Elită";
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

<div class="container-fluid py-5 px-lg-5" style="background: #f8f9fa;">
    <!-- Header Hero Section -->
    <div class="row align-items-center mb-5 animate__animated animate__fadeIn">
        <div class="col-lg-7">
            <h1 class="display-4 fw-bolder text-dark tracking-tight mb-2">
                Descoperă <span class="text-primary text-gradient">Comori</span> Digitale
            </h1>
            <p class="fs-5 text-muted fw-light">Licitează în timp real pentru cele mai rare obiecte din comunitatea NetAuction.</p>
        </div>
        <div class="col-lg-5 text-lg-end">
            @if (User.Identity.IsAuthenticated)
            {
                <a asp-action="Create" class="btn btn-primary btn-lg rounded-pill px-5 py-3 shadow-lg hover-lift">
                    <i class="bi bi-plus-lg me-2"></i>Lansează o Licitație
                </a>
            }
        </div>
    </div>

    <!-- Smart Filter Bar: Glassmorphism Design -->
    <div class="card border-0 shadow-sm rounded-5 mb-5 glass-filter animate__animated animate__fadeInUp">
        <div class="card-body p-4">
            <form asp-action="Index" method="get" class="row g-3 align-items-end">
                <!-- Toggle Filters -->
                <div class="col-12 mb-2">
                    <div class="d-flex gap-2 p-1 bg-light rounded-pill d-inline-flex border">
                        <a class="btn rounded-pill px-4 py-2 @(Context.Request.Query["filter"] != "mine" ? "btn-white shadow-sm" : "btn-light text-muted")"
                           asp-action="Index" asp-route-filter="all">Toate</a>

                        @if (User.Identity.IsAuthenticated)
                        {
                            <a class="btn rounded-pill px-4 py-2 @(Context.Request.Query["filter"] == "mine" ? "btn-white shadow-sm" : "btn-light text-muted")"
                               asp-action="Index" asp-route-filter="mine">Ale Mele</a>
                        }
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-floating">
                        <input type="text" name="searchString" class="form-control border-0 bg-light rounded-4 px-4"
                               id="searchLabel" placeholder="Căutare..." value="@Context.Request.Query["searchString"]">
                        <label for="searchLabel" class="ps-4">Ce cauți astăzi?</label>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="form-floating">
                        <select name="categorie" class="form-select border-0 bg-light rounded-4 px-4" id="catLabel"
                                asp-items="Html.GetEnumSelectList<WebApplication1.Models.CategorieLicitatie>()">
                            <option value="">Toate categoriile</option>
                        </select>
                        <label for="catLabel" class="ps-4">Categorie</label>
                    </div>
                </div>

                <div class="col-md-2">
                    <div class="form-floating">
                        <input type="number" name="pretMax" class="form-control border-0 bg-light rounded-4 px-4"
                               id="priceLabel" placeholder="Buget" value="@Context.Request.Query["pretMax"]">
                        <label for="priceLabel" class="ps-4">Buget Max (RON)</label>
                    </div>
                </div>

                <div class="col-md-3 d-flex gap-2 py-1">
                    <button type="submit" class="btn btn-dark flex-grow-1 rounded-4 py-3 fw-bold transition-all">
                        <i class="bi bi-search me-2"></i>Caută
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-4 py-3 px-3">
                        <i class="bi bi-arrow-counterclockwise fs-5"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Results Grid -->
    <div class="row g-4 animate__animated animate__fadeInUp animate__delay-1s">
        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5">
                <div class="bg-white d-inline-block p-5 rounded-5 shadow-sm">
                    <i class="bi bi-emoji-frown text-muted display-1"></i>
                    <h3 class="mt-4 fw-bold">Niciun rezultat găsit</h3>
                    <p class="text-muted">Încearcă să schimbi filtrele sau caută cuvinte mai generale.</p>
                </div>
            </div>
        }

        @foreach (var item in Model)
        {
            <div class="col-sm-6 col-xl-3">
                <div class="card h-100 border-0 shadow-sm bento-card rounded-5 overflow-hidden transition-all">
                    <!-- Image Wrapper with Overlay -->
                    <div class="position-relative overflow-hidden group" style="height: 240px;">
                        @if (!string.IsNullOrEmpty(item.ImaginePath))
                        {
                            <img src="~/images/@item.ImaginePath" class="w-100 h-100 object-fit-cover transition-transform" alt="@item.titlu">
                        }
                        else
                        {
                            <div class="w-100 h-100 bg-light-subtle d-flex align-items-center justify-content-center">
                                <i class="bi bi-image text-muted display-4"></i>
                            </div>
                        }

                        <!-- Floating Category -->
                        <div class="position-absolute top-0 start-0 m-3">
                            <span class="badge glass-badge rounded-pill px-3 py-2 text-white fw-bold">
                                @item.Categorie
                            </span>
                        </div>

                        <!-- Status Indicator -->
                        @if (item.data_finalizare < DateTime.Now.AddHours(2) && !item.EsteIncheiata)
                        {
                            <div class="position-absolute bottom-0 start-0 w-100 p-2 bg-danger text-white text-center small fw-bold animate__animated animate__pulse animate__infinite">
                                <i class="bi bi-clock-history me-1"></i> EXPIRĂ CURÂND
                            </div>
                        }
                    </div>

                    <div class="card-body p-4">
                        <h5 class="fw-bold text-dark mb-3 text-truncate-2" style="height: 3rem;">@item.titlu</h5>

                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div>
                                <p class="text-muted small text-uppercase fw-bold mb-0" style="font-size: 0.65rem; letter-spacing: 1px;">Preț Actual</p>
                                <span class="fs-4 fw-bolder text-success">@item.PretCurent <small class="fs-6">RON</small></span>
                            </div>
                            <div class="text-end">
                                <p class="text-muted small text-uppercase fw-bold mb-0" style="font-size: 0.65rem; letter-spacing: 1px;">Data Limită</p>
                                <span class="fw-bold text-dark">@item.data_finalizare.ToString("dd MMM")</span>
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <a asp-action="Details" asp-route-id="@item.id" class="btn btn-primary flex-grow-1 rounded-pill py-2 fw-bold shadow-sm">
                                Licitează <i class="bi bi-arrow-right-short ms-1"></i>
                            </a>

                            @if (User.Identity.IsAuthenticated && item.seller_id == currentUserId)
                            {
                                <form asp-action="Delete" asp-route-id="@item.id" method="post" onsubmit="return confirm('Sigur ștergi?');">
                                    <button type="submit" class="btn btn-outline-danger rounded-circle p-2 px-3 border-0 bg-light">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    /* Premium UI Styling */
    .text-gradient {
        background: linear-gradient(45deg, #0d6efd, #0dcaf0);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .rounded-5 {
        border-radius: 1.5rem !important;
    }

    .tracking-tight {
        letter-spacing: -1.5px;
    }

    .glass-filter {
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(10px);
    }

    .btn-white {
        background: white;
        color: #0d6efd;
    }

    .bento-card {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

        .bento-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 1.5rem 3rem rgba(0,0,0,0.1) !important;
        }

            .bento-card:hover img {
                transform: scale(1.1);
            }

    .glass-badge {
        background: rgba(0,0,0,0.5);
        backdrop-filter: blur(5px);
        font-size: 0.7rem;
        letter-spacing: 0.5px;
    }

    .hover-lift:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 20px rgba(13, 110, 253, 0.3) !important;
    }

    .text-truncate-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .bg-light-subtle {
        background-color: #f1f3f5;
    }

    /* Transitions */
    .transition-all {
        transition: all 0.3s ease;
    }

    .transition-transform {
        transition: transform 0.5s ease;
    }
</style>