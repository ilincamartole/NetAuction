@model IEnumerable<WebApplication1.Models.Licitatie>
@using System.Security.Claims

@{
    ViewData["Title"] = "Explorați Licitațiile";
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

<div class="container py-4">
    <!-- Header Secțiune -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h1 class="fw-bold display-5 mb-1">Licitații Active</h1>
            <p class="text-muted">Găsește obiecte unice și licitează în timp real.</p>
        </div>

        @if (User.Identity.IsAuthenticated)
        {
            <a asp-action="Create" class="btn btn-primary btn-lg rounded-pill px-4 shadow-sm">
                <i class="bi bi-plus-circle me-2"></i>Adaugă Licitație
            </a>
        }
    </div>

    <!-- Filtre și Navigare -->
    <div class="card border-0 shadow-sm rounded-4 mb-5">
        <div class="card-body p-4">
            <!-- Tab-uri pentru filtrare rapidă -->
            <ul class="nav nav-pills mb-4 border-bottom pb-3">
                <li class="nav-item">
                    <a class="nav-link rounded-pill @(Context.Request.Query["filter"] != "mine" ? "active" : "")"
                       asp-action="Index" asp-route-filter="all">
                        <i class="bi bi-grid-fill me-2"></i>Toate Licitațiile
                    </a>
                </li>
                @if (User.Identity.IsAuthenticated)
                {
                    <li class="nav-item">
                        <a class="nav-link rounded-pill @(Context.Request.Query["filter"] == "mine" ? "active" : "")"
                           asp-action="Index" asp-route-filter="mine">
                            <i class="bi bi-person-badge me-2"></i>Licitațiile Mele
                        </a>
                    </li>
                }
            </ul>

            <!-- Formular Filtrare Detaliată -->
            <form asp-action="Index" method="get" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label small fw-bold text-uppercase text-muted">Caută titlu</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search"></i></span>
                        <input type="text" name="searchString" class="form-control border-start-0 ps-0 shadow-none"
                               placeholder="Ex: Ceas vechi..." value="@Context.Request.Query["searchString"]" />
                    </div>
                </div>

                <div class="col-md-3">
                    <label class="form-label small fw-bold text-uppercase text-muted">Categorie</label>
                    <select name="categorie" class="form-select shadow-none"
                            asp-items="Html.GetEnumSelectList<WebApplication1.Models.CategorieLicitatie>()">
                        <option value="">Toate categoriile</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label small fw-bold text-uppercase text-muted">Preț Max (RON)</label>
                    <input type="number" name="pretMax" class="form-control shadow-none"
                           placeholder="500" value="@Context.Request.Query["pretMax"]" />
                </div>

                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-dark w-100 rounded-3">
                        <i class="bi bi-funnel me-1"></i> Filtrează
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary w-50 rounded-3">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Grid de Licitații (Înlocuiește tabelul) -->
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4">
        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5">
                <i class="bi bi-search text-muted display-1"></i>
                <p class="mt-3 fs-5 text-muted">Nu am găsit nicio licitație care să corespundă criteriilor.</p>
            </div>
        }

        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 border-0 shadow-sm hover-card transition-all rounded-4 overflow-hidden">
                    <!-- Badge pentru Categorie -->
                    <span class="position-absolute top-0 start-0 m-3 badge bg-dark opacity-75 rounded-pill px-3">
                        @item.Categorie
                    </span>

                    <!-- Imagine Produs -->
                    <div class="card-img-container bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
                        @if (!string.IsNullOrEmpty(item.ImaginePath))
                        {
                            <img src="~/images/@item.ImaginePath" class="card-img-top h-100 w-100 object-fit-cover" alt="@item.titlu">
                        }
                        else
                        {
                            <i class="bi bi-image text-muted display-4"></i>
                        }
                    </div>

                    <div class="card-body p-3">
                        <h6 class="card-title fw-bold text-dark mb-1 text-truncate">@item.titlu</h6>

                        <div class="d-flex justify-content-between align-items-end mt-3">
                            <div>
                                <small class="text-muted d-block small text-uppercase" style="font-size: 0.65rem;">Preț Curent</small>
                                <span class="fw-bold text-success fs-5">@item.PretCurent RON</span>
                            </div>
                            <div class="text-end">
                                <small class="text-muted d-block small text-uppercase" style="font-size: 0.65rem;">Expiră la</small>
                                <span class="small fw-bold @(item.data_finalizare < DateTime.Now.AddDays(1) ? "text-danger" : "text-dark")">
                                    @item.data_finalizare.ToString("dd.MM HH:mm")
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="card-footer bg-white border-0 p-3 pt-0 d-flex gap-2">
                        <a asp-action="Details" asp-route-id="@item.id" class="btn btn-outline-primary btn-sm flex-grow-1 rounded-pill fw-bold">
                            Vezi Detalii
                        </a>

                        @if (User.Identity.IsAuthenticated && item.seller_id == currentUserId)
                        {
                            <a asp-action="Delete" asp-route-id="@item.id" class="btn btn-outline-danger btn-sm rounded-circle shadow-none" title="Șterge">
                                <i class="bi bi-trash"></i>
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    /* Efecte Vizuale */
    .hover-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .hover-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 1rem 2rem rgba(0,0,0,0.12) !important;
        }

    .object-fit-cover {
        object-fit: cover;
    }

    .nav-pills .nav-link {
        color: #6c757d;
        font-weight: 500;
    }

        .nav-pills .nav-link.active {
            background-color: #0d6efd;
        }

    .card-img-container {
        overflow: hidden;
    }
</style>