@{
    ViewData["Title"] = "Activitate Licitare (React SPA)";
}

<div id="react-oferte-root"></div>

<style>
    /* Menținem stilurile originale pentru design consistent */
    .rounded-5 {
        border-radius: 2rem !important;
    }

    .tracking-wider {
        letter-spacing: 1.5px;
    }

    .hover-up:hover {
        transform: translateY(-5px);
        box-shadow: 0 1rem 3rem rgba(0,0,0,0.1) !important;
    }

    .btn-white {
        background: white;
        border: 1px solid #dee2e6;
        color: #495057;
    }

        .btn-white:hover {
            background-color: #0d6efd;
            color: white !important;
            border-color: #0d6efd;
        }
</style>

@section Scripts {
    <script type="module" src="~/dist/oferte.js" asp-append-version="true"></script>
}