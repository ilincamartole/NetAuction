@{
    ViewData["Title"] = "Ghid de Cumpărături AI";
}

<div class="container py-5">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb bg-white p-3 rounded-4 shadow-sm border-0">
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none fw-medium text-primary">Piața de Licitații</a></li>
            <li class="breadcrumb-item active fw-bold text-dark">Asistent </li>
        </ol>
    </nav>

    <div id="react-app-root"></div>
</div>

<style>
    body {
        background-color: #f0f2f5;
    }

    .shadow-2-strong {
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.15);
    }

    .tracking-wider {
        letter-spacing: 0.1em;
    }

    .leading-relaxed {
        line-height: 1.8;
    }

    .hover-up-btn {
        transition: all 0.3s ease;
    }

        .hover-up-btn:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(13, 110, 253, 0.3) !important;
        }
</style>

@section Scripts {
    <script type="module" src="~/dist/main.js" asp-append-version="true"></script>
}