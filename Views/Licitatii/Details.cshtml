@model WebApplication1.Models.Licitatie
@using System.Security.Claims

@{
    ViewData["Title"] = "Detalii Licitație";
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var isAdmin = User.IsInRole("Admin");

    // Corecție sigură pentru erorile de tip cast la nivel de runtime
    var istoricOferte = ViewBag.IstoricOferte as List<WebApplication1.Models.Bid>;
}

<div class="container py-5">
    @* --- ALERTE FEEDBACK --- *@
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-5 shadow-sm mb-4 border-0 animate__animated animate__fadeInDown" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-check-circle-fill me-3 fs-4"></i>
                <div>@TempData["Success"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-5 shadow-sm mb-4 border-0 animate__animated animate__fadeInDown" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-exclamation-triangle-fill me-3 fs-4"></i>
                <div>@TempData["Error"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb bg-white p-3 rounded-4 shadow-sm border-0">
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none fw-medium text-primary">Piața de Licitații</a></li>
            <li class="breadcrumb-item active fw-bold text-dark">@Model.Categorie.ToString()</li>
        </ol>
    </nav>

    <div class="row g-5">
        <div class="col-lg-7">
            <div class="card border-0 shadow-lg rounded-5 overflow-hidden animate__animated animate__fadeIn">
                <div class="position-relative bg-dark d-flex align-items-center justify-content-center" style="min-height: 550px;">
                    @if (!string.IsNullOrEmpty(Model.ImaginePath))
                    {
                        <img src="~/images/@Model.ImaginePath" class="img-fluid w-100" alt="@Model.titlu" style="max-height: 650px; object-fit: contain;" />
                    }
                    else
                    {
                        <div class="text-white-50 text-center">
                            <i class="bi bi-image display-1"></i>
                            <p class="mt-3 fs-5">Imaginea nu a fost încărcată</p>
                        </div>
                    }
                    <div class="position-absolute top-0 end-0 m-4">
                        <span class="badge bg-blur text-white px-3 py-2 rounded-pill shadow-sm">
                            <i class="bi bi-tag-fill me-1"></i> @Model.Categorie
                        </span>
                    </div>
                </div>
            </div>

            <div class="mt-5">
                <ul class="nav nav-pills mb-4 gap-2" id="pills-tab" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active rounded-pill px-4 fw-bold" id="pills-desc-tab" data-bs-toggle="pill" data-bs-target="#pills-desc" type="button" role="tab">Descriere</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link rounded-pill px-4 fw-bold" id="pills-history-tab" data-bs-toggle="pill" data-bs-target="#pills-history" type="button" role="tab">Istoric Oferte</button>
                    </li>
                </ul>

                <div class="tab-content" id="pills-tabContent">
                    <div class="tab-pane fade show active" id="pills-desc" role="tabpanel">
                        <div class="card border-0 shadow-sm rounded-5 p-4">
                            <h4 class="fw-bold mb-4 text-dark">Despre acest obiect</h4>
                            <p class="text-secondary leading-relaxed fs-5" style="white-space: pre-line;">@Model.descriere</p>
                        </div>
                    </div>
                    <div class="tab-pane fade" id="pills-history" role="tabpanel">
                        <div class="card border-0 shadow-sm rounded-5 p-4">
                            @if (istoricOferte != null && istoricOferte.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle border-0">
                                        <thead>
                                            <tr class="text-muted small text-uppercase">
                                                <th class="border-0">Ofertant</th>
                                                <th class="border-0">Sumă</th>
                                                <th class="border-0 text-end">Dată</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var bid in istoricOferte)
                                            {
                                                <tr>
                                                    <td class="border-0">
                                                        <div class="d-flex align-items-center">
                                                            <div class="avatar-sm bg-light text-primary rounded-circle me-2 d-flex align-items-center justify-content-center" style="width:32px; height:32px;">
                                                                <i class="bi bi-person-fill"></i>
                                                            </div>
                                                            <span class="fw-bold text-dark">
                                                                @{
                                                                    var d = ViewBag.Usernames as Dictionary<string, string>;
                                                                    @(d != null && d.ContainsKey(bid.userId) ? d[bid.userId] : "Utilizator")
                                                                }
                                                            </span>
                                                        </div>
                                                    </td>
                                                    <td class="border-0"><span class="badge bg-success-subtle text-success rounded-pill px-3">@bid.suma RON</span></td>
                                                    <td class="border-0 text-end text-muted small">@bid.data.ToString("dd MMM HH:mm")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <p class="text-muted text-center my-3">Nu există nicio ofertă plasată pentru acest produs.</p>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="sticky-top" style="top: 2rem; z-index: 10;">
                <div class="card border-0 shadow-2-strong rounded-5 overflow-hidden animate__animated animate__fadeInRight">

                    <div class="@(Model.EsteIncheiata ? "bg-secondary" : "bg-primary") p-4 text-white text-center position-relative">
                        <small class="text-white-50 text-uppercase fw-bold tracking-wider">@(Model.EsteIncheiata ? "Licitație Finalizată" : "Timpul Rămâne:")</small>
                        <div id="live-timer" class="display-6 fw-bolder mt-1">
                            @if (Model.EsteIncheiata)
                            {
                                <span>ÎNCHEIATĂ</span>
                            }
                            else
                            {
                                <span>Se încarcă...</span>
                            }
                        </div>
                    </div>

                    <div class="card-body p-4 p-xl-5">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div>
                                <small class="text-muted d-block fw-bold text-uppercase" style="font-size: 0.7rem;">Ofertă Curentă</small>
                                <h2 class="text-success fw-bolder display-5 mb-0">@Model.PretCurent <small class="fs-4">RON</small></h2>
                            </div>
                            <div class="text-end">
                                <small class="text-muted d-block fw-bold text-uppercase" style="font-size: 0.7rem;">Preț Start</small>
                                <span class="fw-bold text-dark fs-5">@Model.PretPornire RON</span>
                            </div>
                        </div>

                        @* --- SECTIUNE STATICA REZULTAT VS COMPONENTA PLASARE OFERTA --- *@
                        @if (Model.EsteIncheiata)
                        {
                            <div class="alert alert-dark rounded-4 p-4 text-center border-0 shadow-sm mb-4">
                                <i class="bi bi-trophy-fill display-5 text-warning mb-3"></i>
                                <h5 class="fw-bold">Rezultat Final</h5>

                                @if (!string.IsNullOrEmpty(Model.CastigatorId))
                                {
                                    <p class="mb-0 fs-5">Câștigător: <span class="text-primary fw-bolder">@ViewBag.WinnerName</span></p>

                                    @if (isAdmin)
                                    {
                                        <div class="mt-4 p-3 bg-white rounded-4 border border-primary-subtle text-start shadow-sm animate__animated animate__fadeIn">
                                            <h6 class="fw-bold text-primary mb-3 small text-uppercase tracking-tight">
                                                <i class="bi bi-shield-lock me-2"></i>Date Contact (Admin Only)
                                            </h6>
                                            <div class="d-flex flex-column gap-2 small">
                                                <div class="d-flex align-items-center">
                                                    <i class="bi bi-person me-2 text-muted"></i>
                                                    <span class="fw-bold">@ViewBag.WinnerFullName</span>
                                                </div>
                                                <div class="d-flex align-items-center">
                                                    <i class="bi bi-envelope me-2 text-muted"></i>
                                                    <a href="mailto:@ViewBag.WinnerEmail" class="text-decoration-none">@ViewBag.WinnerEmail</a>
                                                </div>
                                                <div class="d-flex align-items-center">
                                                    <i class="bi bi-geo-alt me-2 text-muted"></i>
                                                    <span>@ViewBag.WinnerAddress</span>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <p class="mb-0 text-muted">Licitație încheiată fără oferte.</p>
                                }
                            </div>

                            @* --- PANOUL DE CONFIRMARE PLATĂ (DOAR PENTRU VÂNZĂTOR) --- *@
                            @if (!string.IsNullOrEmpty(Model.CastigatorId) && currentUserId == Model.seller_id)
                            {
                                <div class="card border border-primary-subtle shadow-sm rounded-4 mb-4 bg-white animate__animated animate__fadeIn">
                                    <div class="card-header bg-primary text-white p-3 border-0 d-flex align-items-center rounded-top-4">
                                        <i class="bi bi-shield-check fs-5 me-2"></i>
                                        <h6 class="mb-0 fw-bold">Gestionare Tranzacție</h6>
                                    </div>
                                    <div class="card-body p-3">
                                        @if (!Model.PlataConfirmata)
                                        {
                                            <p class="text-muted small mb-3">Bifează căsuța de mai jos doar după ce ai verificat contul și ai primit banii de la cumpărător.</p>
                                            <form asp-action="ConfirmaPlata" asp-route-id="@Model.id" method="post" id="formConfirmaPlata">
                                                <div class="form-check form-switch p-3 bg-light rounded-3 d-flex align-items-center justify-content-between border">
                                                    <label class="form-check-label fw-bold text-dark cursor-pointer mb-0 ps-2" for="switchPlata" style="font-size: 0.9rem;">
                                                        Confirm încasarea plății
                                                    </label>
                                                    <input class="form-check-input cursor-pointer m-0" type="checkbox" id="switchPlata" style="width: 2.5em; height: 1.25em;">
                                                </div>
                                            </form>
                                        }
                                        else
                                        {
                                            <div class="alert alert-success-subtle border border-success text-success rounded-3 d-flex align-items-center p-2 m-0" role="alert">
                                                <i class="bi bi-check-circle-fill me-2 fs-4"></i>
                                                <div class="small">
                                                    <strong class="d-block">Plată Confirmată!</strong>
                                                    Cumpărătorul a fost notificat.
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        }
                        else if (currentUserId == Model.seller_id)
                        {
                            <div class="alert alert-info rounded-5 p-4 text-center border-0 shadow-sm mb-4 animate__animated animate__fadeIn">
                                <i class="bi bi-info-circle-fill display-6 text-primary mb-2"></i>
                                <h6 class="fw-bold mb-1">Aceasta este licitația ta</h6>
                                <p class="mb-0 text-muted small">Nu poți plasa oferte la propriul tău produs.</p>
                            </div>
                        }
                        else
                        {
                            <div class="p-4 bg-light rounded-5 border-dashed border-2 border-primary mb-4">
                                <label class="form-label fw-bolder text-dark mb-3">Crește miza acum</label>
                                <form asp-action="Licitare" method="post" id="formLicitare">
                                    <input type="hidden" name="id" value="@Model.id" />
                                    <div class="input-group input-group-lg mb-3 shadow-sm rounded-pill overflow-hidden border-0">
                                        <span class="input-group-text bg-white border-0 text-primary fw-bold">RON</span>
                                        <input type="number" name="sumaLicitata" class="form-control border-0 ps-0 fw-bold"
                                               placeholder="@(Model.PretCurent + 1)" min="@(Model.PretCurent + 0.01m)" step="0.01" required />
                                    </div>
                                    <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill fw-bolder py-3 shadow-lg hover-up-btn">
                                        <i class="bi bi-hammer me-2"></i>Plasează Ofertă
                                    </button>
                                </form>
                            </div>
                        }

                        <div class="d-flex align-items-center p-3 rounded-4 bg-light">
                            <div class="avatar-md bg-white text-primary rounded-circle d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 50px; height: 50px;">
                                <i class="bi bi-person-badge fs-4"></i>
                            </div>
                            <div>
                                <small class="text-muted d-block">Vânzător autorizat</small>
                                <span class="text-dark fw-bold">@ViewBag.SellerName</span>
                            </div>
                        </div>

                        <div class="row mt-4 g-2">
                            <div class="col-12">
                                <a asp-action="Index" class="btn btn-outline-light text-muted w-100 rounded-pill btn-sm border py-2">
                                    <i class="bi bi-arrow-left me-1"></i> Înapoi la listă
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

<style>
    body {
        background-color: #f0f2f5;
    }

    .shadow-2-strong {
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.15);
    }

    .bg-blur {
        background: rgba(0,0,0,0.4);
        backdrop-filter: blur(10px);
    }

    .tracking-wider {
        letter-spacing: 0.1em;
    }

    .leading-relaxed {
        line-height: 1.8;
    }

    .border-dashed {
        border-style: dashed !important;
    }

    .nav-pills .nav-link.active {
        background: #0d6efd;
        box-shadow: 0 10px 20px rgba(13, 110, 253, 0.2);
    }

    .hover-up-btn:hover {
        transform: translateY(-5px);
        transition: transform 0.2s ease-in-out;
    }

    .tracking-tight {
        letter-spacing: -0.5px;
    }
</style>

@section Scripts {
    <script>
        function startTimer(targetDate) {
            const timerElement = document.getElementById("live-timer");
            if (!timerElement || @Model.EsteIncheiata.ToString().ToLower()) return;

            const interval = setInterval(function() {
                const now = new Date().getTime();
                const distance = targetDate - now;
                if (distance < 0) {
                    clearInterval(interval);
                    timerElement.innerHTML = "EXPIRAT";
                    window.location.reload();
                    return;
                }
                const days = Math.floor(distance / (1000 * 60 * 60 * 24));
                const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
                const seconds = Math.floor((distance % (1000 * 60)) / 1000);
                let display = (days > 0 ? days + "z " : "") +
                              hours.toString().padStart(2, '0') + "h " +
                              minutes.toString().padStart(2, '0') + "m " +
                              seconds.toString().padStart(2, '0') + "s";
                timerElement.innerHTML = display;
                if (distance < 3600000) {
                    timerElement.parentElement.classList.replace('bg-primary', 'bg-danger');
                    timerElement.classList.add('animate__animated', 'animate__pulse', 'animate__infinite');
                }
            }, 1000);
        }
        const endDateTime = new Date("@Model.data_finalizare.ToString("yyyy-MM-ddTHH:mm:ss")").getTime();
        startTimer(endDateTime);
    </script>

}