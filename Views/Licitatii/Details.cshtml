@model WebApplication1.Models.Licitatie
@using System.Security.Claims

@{
    ViewData["Title"] = "Detalii Licitație";
}

@Html.AntiForgeryToken()

<script>
    window.currentLicitatieId = parseInt("@Model.id");
    window.currentUserId = "@User.FindFirstValue(ClaimTypes.NameIdentifier)";
    window.isUserAdmin = @User.IsInRole("Admin").ToString().ToLower();
</script>

<div class="container py-5">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb bg-white p-3 rounded-4 shadow-sm border-0">
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none fw-medium text-primary">Piața de Licitații</a></li>
            <li class="breadcrumb-item active fw-bold text-dark">Modul Detalii React Live</li>
        </ol>
    </nav>

    <div id="react-details-root"></div>
</div>

<style>
    body {
        background-color: #f0f2f5;
    }

    .shadow-2-strong {
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.15);
    }

    .rounded-5 {
        border-radius: 2rem !important;
    }

    .border-dashed {
        border-style: dashed !important;
    }

    .nav-pills .nav-link.active {
        background: #0d6efd;
        box-shadow: 0 10px 20px rgba(13, 110, 253, 0.2);
    }

    .hover-up-btn:hover {
        transform: translateY(-5px);
        transition: transform 0.2s ease-in-out;
    }
</style>

@section Scripts {
    <script type="module" src="~/dist/details.js" asp-append-version="true"></script>
}