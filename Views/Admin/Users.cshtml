@using Microsoft.AspNetCore.Identity
@inject UserManager<WebApplication1.Models.ApplicationUser> UserManager
@model IEnumerable<WebApplication1.Models.ApplicationUser>

@{
    ViewData["Title"] = "Gestionare Utilizatori";
}

<div class="container mt-4">
    <!-- Header cu Statistici Rapide -->
    <div class="row mb-4 align-items-center">
        <div class="col-md-6">
            <h2 class="fw-bold"><i class="bi bi-shield-lock me-2 text-primary"></i>Admin Panel</h2>
            <p class="text-muted">Gestionarea accesului și rolurilor pentru comunitatea NetAuction</p>
        </div>
        <div class="col-md-6 text-md-end">
            <div class="d-inline-flex gap-3">
                <div class="bg-white p-2 px-3 rounded-4 shadow-sm border">
                    <small class="text-muted d-block">Total Membri</small>
                    <span class="fw-bold fs-5">@Model.Count()</span>
                </div>
                <div class="bg-white p-2 px-3 rounded-4 shadow-sm border">
                    <small class="text-muted d-block">Suspendări</small>
                    <span class="fw-bold fs-5 text-danger">@Model.Count(u => u.IsSuspended)</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Card Principal Tabel -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white py-3 border-bottom">
            <div class="row align-items-center">
                <div class="col">
                    <h5 class="mb-0 fw-bold">Listă Utilizatori</h5>
                </div>
                <div class="col-auto">
                    <div class="input-group input-group-sm" style="width: 250px;">
                        <span class="input-group-text bg-light border-0"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control bg-light border-0" placeholder="Caută după email...">
                    </div>
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted small uppercase">
                    <tr>
                        <th class="ps-4 py-3">Utilizator</th>
                        <th>Status</th>
                        <th>Rol</th>
                        <th class="text-end pe-4">Acțiuni de Control</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        var isAdmin = await UserManager.IsInRoleAsync(user, "Admin");
                        <tr>
                            <td class="ps-4 py-3">
                                <div class="d-flex align-items-center">
                                    <div class="avatar-sm me-3 bg-light rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                        <i class="bi bi-person text-secondary"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark">@user.Email</div>
                                        <small class="text-muted">ID: @user.Id.ToString().Substring(0, 8)...</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                @if (user.IsSuspended)
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 rounded-pill">
                                        <i class="bi bi-slash-circle me-1"></i> Suspendat
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 rounded-pill">
                                        <i class="bi bi-check-circle me-1"></i> Activ
                                    </span>
                                }
                            </td>
                            <td>
                                <span class="badge @(isAdmin ? "bg-warning-subtle text-warning-emphasis border-warning-subtle" : "bg-light text-secondary border-secondary-subtle") border px-3 rounded-pill">
                                    <i class="bi @(isAdmin ? "bi-star-fill" : "bi-person") me-1"></i>
                                    @(isAdmin ? "Admin" : "Utilizator")
                                </span>
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group shadow-sm rounded-pill overflow-hidden">
                                    @* Buton Suspendare *@
                                    <form asp-action="ToggleSuspension" asp-route-userId="@user.Id" method="post" class="d-inline m-0">
                                        <button type="submit" class="btn btn-sm btn-white border-end @(user.IsSuspended ? "text-success" : "text-danger") py-2 px-3"
                                                title="@(user.IsSuspended ? "Activează" : "Suspendă")">
                                            <i class="bi @(user.IsSuspended ? "bi-person-check-fill" : "bi-person-x-fill")"></i>
                                        </button>
                                    </form>

                                    @* Buton Toggle Admin *@
                                    <form asp-action="ToggleAdmin" asp-route-userId="@user.Id" method="post" class="d-inline m-0">
                                        <button type="submit" class="btn btn-sm btn-white @(isAdmin ? "text-dark" : "text-warning") py-2 px-3"
                                                title="@(isAdmin ? "Scoate Admin" : "Fă Admin")">
                                            <i class="bi @(isAdmin ? "bi-shield-slash-fill" : "bi-shield-check")"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="card-footer bg-white border-top py-3 text-center">
            <small class="text-muted">Actualizat la: @DateTime.Now.ToString("HH:mm")</small>
        </div>
    </div>
</div>

<style>
    /* Efecte suplimentare pentru Admin Panel */
    .table-hover tbody tr:hover {
        background-color: #fbfcfe;
    }

    .btn-white {
        background: white;
        transition: all 0.2s;
    }

        .btn-white:hover {
            background: #f8f9fa;
        }

    .bg-danger-subtle {
        background-color: #fee2e2 !important;
    }

    .bg-success-subtle {
        background-color: #dcfce7 !important;
    }

    .bg-warning-subtle {
        background-color: #fef9c3 !important;
    }
</style>