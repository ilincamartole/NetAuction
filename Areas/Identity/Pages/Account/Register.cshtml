@page
@model RegisterModel
@{
    ViewData["Title"] = "Creează Cont";
}

<div class="container-fluid min-vh-100 d-flex align-items-center justify-content-center py-5 animate__animated animate__fadeIn"
     style="background: linear-gradient(135deg, #f0f4f8 0%, #d9e2ec 100%);">

    <div class="row w-100 justify-content-center">
        <div class="col-12 col-md-11 col-lg-10 col-xl-9">
            <div class="card border-0 shadow-lg rounded-5 overflow-hidden bg-white">
                <div class="row g-0">

                    <!-- Partea Stângă: Brand & Info -->
                    <div class="col-lg-5 d-none d-lg-flex flex-column align-items-center justify-content-center text-white p-5 position-relative"
                         style="background: linear-gradient(rgba(13, 110, 253, 0.9), rgba(13, 202, 240, 0.9)), url('https://images.unsplash.com/photo-1560518883-ce09059eeffa?q=80&w=1973&auto=format&fit=crop'); background-size: cover; background-position: center;">

                        <div class="text-center position-relative z-index-1">
                            <div class="bg-white bg-opacity-20 rounded-circle d-inline-flex p-4 mb-4 shadow-sm backdrop-blur">
                                <i class="bi bi-person-plus-fill display-3"></i>
                            </div>
                            <h2 class="fw-black text-uppercase tracking-wider mb-3">Alătură-te Comunității</h2>
                            <p class="fs-5 opacity-75 fw-light">Creează-ți un cont astăzi și începe să licitezi pentru obiecte unice alături de mii de utilizatori.</p>

                            <ul class="list-unstyled text-start mt-5 fs-6 opacity-90">
                                <li class="mb-3"><i class="bi bi-check2-circle me-2"></i> Licitații sigure și verificate</li>
                                <li class="mb-3"><i class="bi bi-check2-circle me-2"></i> Plăți securizate</li>
                                <li class="mb-3"><i class="bi bi-check2-circle me-2"></i> Suport tehnic 24/7</li>
                            </ul>
                        </div>
                    </div>

                    <!-- Partea Dreaptă: Formular -->
                    <div class="col-lg-7 p-4 p-md-5">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div>
                                <h3 class="fw-bold text-dark mb-1">Înregistrare</h3>
                                <p class="text-muted small">Completează datele pentru a deschide un cont nou.</p>
                            </div>
                            <i class="bi bi-shield-check fs-1 text-primary-emphasis opacity-25"></i>
                        </div>

                        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger-subtle border-0 rounded-4 small mb-4" role="alert"></div>

                            <div class="row g-3">
                                <!-- Secțiunea Identitate -->
                                <div class="col-md-6">
                                    <div class="form-floating mb-1">
                                        <input asp-for="Input.Nume" class="form-control border-0 bg-light rounded-4 px-4" aria-required="true" placeholder="Nume" />
                                        <label asp-for="Input.Nume" class="ps-4">Nume</label>
                                    </div>
                                    <span asp-validation-for="Input.Nume" class="text-danger small px-3"></span>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-floating mb-1">
                                        <input asp-for="Input.Prenume" class="form-control border-0 bg-light rounded-4 px-4" aria-required="true" placeholder="Prenume" />
                                        <label asp-for="Input.Prenume" class="ps-4">Prenume</label>
                                    </div>
                                    <span asp-validation-for="Input.Prenume" class="text-danger small px-3"></span>
                                </div>

                                <!-- Secțiunea Adresă & Contact -->
                                <div class="col-12">
                                    <div class="form-floating mb-1">
                                        <input asp-for="Input.Adresa" class="form-control border-0 bg-light rounded-4 px-4" aria-required="true" placeholder="Adresa" />
                                        <label asp-for="Input.Adresa" class="ps-4">Adresă Completă</label>
                                    </div>
                                    <span asp-validation-for="Input.Adresa" class="text-danger small px-3"></span>
                                </div>

                                <div class="col-12">
                                    <div class="form-floating mb-1">
                                        <input asp-for="Input.Email" class="form-control border-0 bg-light rounded-4 px-4" autocomplete="email" aria-required="true" placeholder="name@example.com" />
                                        <label asp-for="Input.Email" class="ps-4">Email</label>
                                    </div>
                                    <span asp-validation-for="Input.Email" class="text-danger small px-3"></span>
                                </div>

                                <!-- Secțiunea Securitate -->
                                <div class="col-md-6">
                                    <div class="form-floating mb-1">
                                        <input asp-for="Input.Password" class="form-control border-0 bg-light rounded-4 px-4" autocomplete="new-password" aria-required="true" placeholder="parola" />
                                        <label asp-for="Input.Password" class="ps-4">Parolă</label>
                                    </div>
                                    <span asp-validation-for="Input.Password" class="text-danger small px-3"></span>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-floating mb-1">
                                        <input asp-for="Input.ConfirmPassword" class="form-control border-0 bg-light rounded-4 px-4" autocomplete="new-password" aria-required="true" placeholder="confirmare" />
                                        <label asp-for="Input.ConfirmPassword" class="ps-4">Confirmare</label>
                                    </div>
                                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger small px-3"></span>
                                </div>
                            </div>

                            <div class="mt-5">
                                <button id="registerSubmit" type="submit" class="w-100 btn btn-primary btn-lg rounded-pill py-3 fw-bold shadow-lg hover-up-btn">
                                    Creează Contul <i class="bi bi-rocket-takeoff ms-2"></i>
                                </button>
                            </div>

                            <div class="text-center mt-4">
                                <p class="text-muted small">
                                    Ai deja un cont?
                                    <a asp-page="./Login" class="text-primary fw-bold text-decoration-none ms-1">Autentifică-te aici</a>
                                </p>
                            </div>
                        </form>

                        @if ((Model.ExternalLogins?.Count ?? 0) > 0)
                        {
                            <div class="hr-text text-muted my-4">
                                <hr><span class="bg-white px-3 small fw-bold">SAU ÎNREGISTRARE CU</span>
                            </div>

                            <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                                <div class="d-flex justify-content-center gap-3">
                                    @foreach (var provider in Model.ExternalLogins!)
                                    {
                                        <button type="submit" class="btn btn-outline-light border rounded-circle p-3 shadow-sm hover-light"
                                                name="provider" value="@provider.Name" title="Register using @provider.DisplayName">
                                            <i class="bi bi-google fs-5 text-dark"></i>
                                        </button>
                                    }
                                </div>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .fw-black {
        font-weight: 900;
    }

    .rounded-5 {
        border-radius: 2rem !important;
    }

    .shadow-lg {
        box-shadow: 0 1rem 3rem rgba(0,0,0,0.1) !important;
    }

    .backdrop-blur {
        backdrop-filter: blur(8px);
    }

    .form-control:focus {
        background-color: #fff !important;
        box-shadow: 0 0 0 4px rgba(13, 110, 253, 0.1) !important;
    }

    .hover-up-btn {
        transition: all 0.3s ease;
    }

        .hover-up-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(13, 110, 253, 0.3) !important;
        }

    .hr-text {
        position: relative;
        text-align: center;
    }

        .hr-text span {
            position: relative;
            top: -12px;
        }

    .alert-danger-subtle {
        background-color: #fff5f5;
        color: #c53030;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}