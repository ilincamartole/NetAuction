@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<div class="container-fluid min-vh-100 d-flex align-items-center justify-content-center py-5 animate__animated animate__fadeIn"
     style="background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);">

    <div class="row w-100 justify-content-center">
        <div class="col-12 col-md-10 col-lg-9 col-xl-8">
            <div class="card border-0 shadow-2-strong rounded-5 overflow-hidden glass-card">
                <div class="row g-0">

                    <!-- Partea Stângă: Vizual / Brand -->
                    <div class="col-lg-6 d-none d-lg-flex flex-column align-items-center justify-content-center text-white p-5 position-relative"
                         style="background: linear-gradient(rgba(13, 110, 253, 0.85), rgba(13, 202, 240, 0.85)), url('https://images.unsplash.com/photo-1554034483-04fda0d3507b?q=80&w=2070&auto=format&fit=crop'); background-size: cover; background-position: center;">

                        <div class="text-center position-relative z-index-1">
                            <i class="bi bi-shield-lock display-1 mb-4 animate__animated animate__bounceIn"></i>
                            <h2 class="fw-black text-uppercase tracking-wider">Bine ai revenit</h2>
                            <p class="fs-5 opacity-75">Intră în contul tău pentru a nu rata nicio ofertă importantă.</p>
                        </div>

                        <!-- Floating Circles Decor -->
                        <div class="position-absolute top-0 start-0 w-100 h-100 overflow-hidden opacity-10">
                            <div class="rounded-circle bg-white position-absolute" style="width: 300px; height: 300px; top: -100px; left: -100px;"></div>
                            <div class="rounded-circle bg-white position-absolute" style="width: 200px; height: 200px; bottom: -50px; right: -50px;"></div>
                        </div>
                    </div>

                    <!-- Partea Dreaptă: Formular -->
                    <div class="col-lg-6 bg-white p-4 p-md-5">
                        <div class="mb-4">
                            <h3 class="fw-bold text-dark">Autentificare</h3>
                            <p class="text-muted small">Folosește contul local pentru a licita.</p>
                        </div>

                        <section>
                            <form id="account" method="post">
                                <div asp-validation-summary="ModelOnly" class="alert alert-danger-subtle border-0 small rounded-4" role="alert"></div>

                                <div class="form-floating mb-3">
                                    <input asp-for="Input.Email" class="form-control border-0 bg-light rounded-4 px-4" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                                    <label asp-for="Input.Email" class="ps-4 text-muted">Adresa de email</label>
                                    <span asp-validation-for="Input.Email" class="text-danger small px-2"></span>
                                </div>

                                <div class="form-floating mb-3">
                                    <input asp-for="Input.Password" class="form-control border-0 bg-light rounded-4 px-4" autocomplete="current-password" aria-required="true" placeholder="password" />
                                    <label asp-for="Input.Password" class="ps-4 text-muted">Parola</label>
                                    <span asp-validation-for="Input.Password" class="text-danger small px-2"></span>
                                </div>

                                <div class="d-flex justify-content-between align-items-center mb-4 px-2">
                                    <div class="form-check">
                                        <input class="form-check-input shadow-none" asp-for="Input.RememberMe" />
                                        <label asp-for="Input.RememberMe" class="form-check-label small text-muted">
                                            Ține-mă minte
                                        </label>
                                    </div>
                                    <a id="forgot-password" asp-page="./ForgotPassword" class="small text-primary text-decoration-none fw-bold">Ai uitat parola?</a>
                                </div>

                                <button id="login-submit" type="submit" class="w-100 btn btn-primary btn-lg rounded-pill py-3 fw-bold shadow-lg hover-up-btn mb-4">
                                    Conectare <i class="bi bi-arrow-right ms-2"></i>
                                </button>

                                <div class="text-center">
                                    <p class="text-muted small">
                                        Nu ai un cont?
                                        <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="text-primary fw-bold text-decoration-none">Creează unul aici</a>
                                    </p>
                                </div>
                            </form>
                        </section>

                        @if ((Model.ExternalLogins?.Count ?? 0) > 0)
                        {
                            <div class="hr-text text-muted my-4">
                                <hr>
                                <span class="bg-white px-3 small fw-bold">SAU</span>
                            </div>

                            <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                                <div class="d-grid gap-2">
                                    @foreach (var provider in Model.ExternalLogins!)
                                    {
                                        <button type="submit" class="btn btn-outline-light border text-dark rounded-pill py-2 fw-medium shadow-sm hover-light"
                                                name="provider" value="@provider.Name" title="Log in using your @provider.DisplayName account">
                                            <i class="bi bi-google me-2"></i> @provider.DisplayName
                                        </button>
                                    }
                                </div>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Premium UI Tokens */
    .glass-card {
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
    }

    .fw-black {
        font-weight: 900;
    }

    .tracking-wider {
        letter-spacing: 2px;
    }

    .shadow-2-strong {
        box-shadow: 0 15px 50px rgba(0,0,0,0.1);
    }

    /* Custom Form Styling */
    .form-control:focus {
        background-color: #fff !important;
        box-shadow: 0 0 0 4px rgba(13, 110, 253, 0.1) !important;
    }

    .hover-up-btn {
        transition: all 0.3s ease;
    }

        .hover-up-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(13, 110, 253, 0.3) !important;
        }

    /* HR with text in middle */
    .hr-text {
        position: relative;
        text-align: center;
    }

        .hr-text span {
            position: relative;
            top: -12px;
        }

    .alert-danger-subtle {
        background-color: #fff5f5;
        color: #c53030;
    }

    .hover-light:hover {
        background-color: #f8f9fa;
        transform: scale(1.01);
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}